# Keep the Docker build context small by excluding local build outputs and
# repository metadata that are not needed inside the image. Test projects remain
# in the context because the Docker build validates the solution before publish.
# Build outputs — excluded to keep the context small and prevent stale
# local binaries from leaking into the Docker build cache.
**/bin/
**/obj/

# Git metadata.
.git/
.gitignore
.gitattributes

# IDE and editor artefacts.
.vs/
.vscode/
*.user
*.suo

# CI and repository automation files — not needed inside the image.
.github/

# Documentation — not needed inside the image.
docs/
*.md

# Coverage and test results produced locally.
TestResults/
coverage/
nupkgs*/

# Docker files themselves (no need to copy them into the build context).
Dockerfile
.dockerignore
