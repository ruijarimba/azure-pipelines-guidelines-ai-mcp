<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AzurePipelines.Guidelines.Mcp</PackageId>
    <Description>Model Context Protocol (MCP) server implementation for AzurePipelines.Guidelines. Exposes guideline lookup and YAML analysis as MCP tools and resources for AI assistants.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzurePipelines.Guidelines.Core\AzurePipelines.Guidelines.Core.csproj" />
    <ProjectReference Include="..\AzurePipelines.Guidelines.Analysis\AzurePipelines.Guidelines.Analysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AzurePipelines.Guidelines.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <!--
      Use the Abstractions package to avoid pulling the full hosting runtime into this library.
      The concrete Microsoft.Extensions.Hosting is added by Mcp.Host.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="AGENTS.md" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Resources/CapabilitiesResponseDto.cs" />
    <Compile Include="Resources/CapabilitiesSupportDto.cs" />
    <Compile Include="Resources/CatalogueVersionResponseDto.cs" />
    <Compile Include="Resources/DetectionHintDto.cs" />
    <Compile Include="Resources/ErrorResponseDto.cs" />
    <Compile Include="Resources/FixDto.cs" />
    <Compile Include="Resources/GuidelineDetailDto.cs" />
    <Compile Include="Resources/GuidelineSummaryDto.cs" />
    <Compile Include="Tools/CategoryCountDto.cs" />
    <Compile Include="Tools/DetectionHintDto.cs" />
    <Compile Include="Tools/ErrorResponseDto.cs" />
    <Compile Include="Tools/FixDto.cs" />
    <Compile Include="Tools/GuidelineDetailDto.cs" />
    <Compile Include="Tools/GuidelineSummaryDto.cs" />
  </ItemGroup>

</Project>
