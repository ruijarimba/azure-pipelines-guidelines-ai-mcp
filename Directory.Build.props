<Project>

  <!--
	Shared properties for every project in the solution.
	Sub-directories (src/, tools/, tests/) each have their own Directory.Build.props
	that imports this file first and then adds layer-specific settings.
  -->

  <PropertyGroup>
	<!-- Keep generated build and package artifacts in the ignored .artifacts folder by default. -->
	<ArtifactsRoot Condition="'$(ArtifactsRoot)' == ''">$(MSBuildThisFileDirectory).artifacts\</ArtifactsRoot>
	<BaseOutputPath Condition="'$(BaseOutputPath)' == ''">$(ArtifactsRoot)bin\$(MSBuildProjectName)\</BaseOutputPath>
	<BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">$(ArtifactsRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
	<PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(ArtifactsRoot)packages\</PackageOutputPath>
	<DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildThisFileDirectory)**\bin\**;$(MSBuildThisFileDirectory)**\obj\**</DefaultItemExcludes>
	<TargetFramework>net10.0</TargetFramework>
	<LangVersion>latest</LangVersion>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	<WarningLevel>9999</WarningLevel>
	<AnalysisLevel>latest-all</AnalysisLevel>
	<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
