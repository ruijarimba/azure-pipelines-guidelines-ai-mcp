<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>adog-mcp</PackageId>
    <Description>
      .NET global tool that runs the AzurePipelines.Guidelines MCP server over stdio.
      AI assistants (GitHub Copilot, Claude, Cursor, etc.) can connect to it to look up
      Azure Pipelines guidelines and analyse YAML pipeline files.
    </Description>
    <PackageReleaseNotes>This proof-of-concept tool is not production-ready. APIs and behavior may change without notice.</PackageReleaseNotes>
    <!--
      Override the tools/Directory.Build.props default of IsPackable=false.
      This project retains local .NET global-tool packaging configuration and must be packable.
    -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>adog-mcp</ToolCommandName>
    <UserSecretsId>4bfaff7d-c504-470a-bb87-f0237b20ba15</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AzurePipelines.Guidelines.Mcp\AzurePipelines.Guidelines.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The full hosting runtime is needed here to run the MCP server.
      The underlying Mcp library only depends on Hosting.Abstractions.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <!--
      AspNetCore package enables the optional SSE debug transport (MapMcp).
      Production stdio mode does not use it, but it is resolved at startup.
    -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <None Include="AGENTS.md" />
    <None Include="README.md" />
    <None Include="Properties\launchSettings.json" />
  </ItemGroup>

</Project>
