<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>adog-mcp</PackageId>
    <Description>
      .NET global tool that runs the AzurePipelines.Guidelines MCP server over stdio.
      AI assistants (GitHub Copilot, Claude, Cursor, etc.) can connect to it to look up
      Azure Pipelines guidelines and analyse YAML pipeline files.
      Install: dotnet tool install -g adog-mcp
    </Description>
    <!--
      Override the tools/Directory.Build.props default of IsPackable=false.
      This project is published as a .NET global tool via NuGet and must be packable.
    -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>adog-mcp</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AzurePipelines.Guidelines.Mcp\AzurePipelines.Guidelines.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The full hosting runtime is needed here to run the MCP server.
      The underlying Mcp library only depends on Hosting.Abstractions.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
