<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>adog</PackageId>
    <Description>CLI static analyzer for Azure Pipelines YAML. Analyzes pipeline files against the azure-pipelines-guidelines ruleset and reports violations with fix suggestions.</Description>
    <!--
      Publish as a .NET global tool via:
        dotnet tool install -g adog
      This requires PackAsTool=true and ToolCommandName.
    -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>adog</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AzurePipelines.Guidelines.Analysis\AzurePipelines.Guidelines.Analysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
