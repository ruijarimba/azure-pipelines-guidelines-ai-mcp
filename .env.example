# Template for publish-only Docker Hub settings. This file is consumed by
# scripts/publish-mcp-image.ps1 and is intentionally not used by the runtime
# Compose workflow.
DOCKERHUB_USERNAME=ruijarimba
DOCKERHUB_TOKEN=replace-with-a-docker-hub-access-token

# Fully qualified Docker Hub image repository.
DOCKERHUB_IMAGE=ruijarimba/azure-pipelines-guidelines-mcp

