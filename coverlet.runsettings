<?xml version="1.0" encoding="utf-8" ?>
<!--
  Coverlet run settings: controls which code is excluded from coverage reports.
  Referenced by 'dotnet test' automatically when placed at the solution root.
  See: https://github.com/coverlet-coverage/coverlet/blob/master/Documentation/MSBuildIntegration.md
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Exclude source-generated regex DFA runners (auto-generated, not testable by hand). -->
          <ExcludeByAttribute>ExcludeFromCodeCoverage,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/*.g.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
